{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare:stockfish": "bun run scripts/prepare-stockfish.ts",
    "dev": "bun run prepare:stockfish && astro dev",
    "dev:web": "bun run prepare:stockfish && astro dev",
    "start": "bun run prepare:stockfish && astro dev",
    "build": "bun run prepare:stockfish && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "bun test src scripts",
    "test:watch": "bun test src scripts --watch",
    "test:chess": "bun test src/lib/chess/game.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:stockfish-assets": "playwright test --config=playwright.stockfish.config.ts e2e/stockfish-assets.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.1",
    "@procyon/game-core": "workspace:*",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "astro": "^4.15.2",
    "chess.js": "1.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "18.0.8",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.5.3",
    "tailwindcss": "^3.4.10"
  }
}
